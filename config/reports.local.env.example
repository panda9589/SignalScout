# Copy this file to config/reports.local.env for local scheduled report generation.
# config/*.local.env is ignored by Git.

# Set true when you want SignalScout to generate reports automatically.
REPORT_SCHEDULER_ENABLED=true

# Defaults: weekday daily digest at 6 PM, weekly report Sunday at 6 PM.
REPORT_DAILY_CRON=0 0 18 * * MON-FRI
REPORT_WEEKLY_CRON=0 0 18 * * SUN
