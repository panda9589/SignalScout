# Copy this into your deployment environment variables, not into Git as a real prod file.
# Production/staging default: scheduler ON.

INGESTION_SCHEDULER_ENABLED=true

# Required for responsible SEC EDGAR access.
SEC_USER_AGENT=SignalScout your-email@example.com

# SEC ingestion scans all configured companies with CIKs.
INGESTION_SEC_LIMIT_PER_COMPANY=3
INGESTION_SEC_INITIAL_DELAY_MS=60000
INGESTION_SEC_FIXED_DELAY_MS=7200000

# RSS feeds are comma-separated. Examples:
# - Company-specific feed: https://example.com/company-ir-feed.xml|NVDA
# - General feed with auto company matching: https://example.com/market-news.xml
INGESTION_RSS_FEEDS=https://www.sec.gov/news/pressreleases.rss
INGESTION_RSS_LIMIT_PER_FEED=5
INGESTION_RSS_INITIAL_DELAY_MS=90000
INGESTION_RSS_FIXED_DELAY_MS=3600000
