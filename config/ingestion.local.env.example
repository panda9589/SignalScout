# Copy this file to config/ingestion.local.env for local development.
# Local default: scheduler stays OFF so dev restarts do not hit SEC/RSS automatically.

INGESTION_SCHEDULER_ENABLED=false

# SEC EDGAR request identity. Use your own email in your local untracked copy.
SEC_USER_AGENT=SignalScout local-dev your-email@example.com

# Local test cadence values. These only matter if INGESTION_SCHEDULER_ENABLED=true.
INGESTION_SEC_LIMIT_PER_COMPANY=1
INGESTION_SEC_INITIAL_DELAY_MS=60000
INGESTION_SEC_FIXED_DELAY_MS=3600000

# RSS feeds are comma-separated. Use feedUrl|TICKER to force a company, or just feedUrl
# to let the app auto-match against your watchlist.
INGESTION_RSS_FEEDS=https://www.sec.gov/news/pressreleases.rss
INGESTION_RSS_LIMIT_PER_FEED=1
INGESTION_RSS_INITIAL_DELAY_MS=90000
INGESTION_RSS_FIXED_DELAY_MS=3600000
