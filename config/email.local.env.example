# Copy this file to config/email.local.env for local email sending.
# Never commit the copied file. config/*.local.env is ignored by Git.
#
# Gmail setup:
# 1. Turn on 2-Step Verification.
# 2. Create an app password at https://myaccount.google.com/apppasswords
# 3. Paste the 16-character app password into SMTP_PASSWORD below.

REPORT_EMAIL_TO=tyblele@gmail.com
REPORT_EMAIL_FROM=tyblele@gmail.com

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=tyblele@gmail.com
SMTP_PASSWORD=bkbd wqqf feeb bmgv
SMTP_STARTTLS_ENABLED=true
