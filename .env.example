# Environment variables for SignalScout development

# Database
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/signalscout
SPRING_DATASOURCE_USERNAME=scout
SPRING_DATASOURCE_PASSWORD=scout_dev_password

# Redis
SPRING_REDIS_HOST=localhost
SPRING_REDIS_PORT=6379

# AI/LLM
OPENAI_API_KEY=sk-your-key-here
OPENAI_EXTRACTION_MODEL=gpt-4-turbo-preview
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Application
APP_BASE_URL=http://localhost:3000
APP_NAME=SignalScout
APP_VERSION=1.0

# Security
JWT_SECRET=dev-secret-key-change-in-production-very-long-random-string-here
JWT_EXPIRATION_MS=86400000

# Logging
LOGGING_LEVEL_ROOT=INFO
LOGGING_LEVEL_COM_SCOUT=DEBUG

# Cost & Limits
AI_DAILY_COST_LIMIT_USD=10.00
AI_MONTHLY_COST_LIMIT_USD=300.00
MAX_DOCUMENT_SIZE_MB=50
RATE_LIMIT_REQUESTS_PER_MINUTE=60

# Scheduled Ingestion
# For local/dev, prefer config/ingestion.local.env copied from config/ingestion.local.env.example.
# For deployment, copy values from config/ingestion.prod.env.example into your host env/secrets.
INGESTION_SCHEDULER_ENABLED=false
SEC_USER_AGENT=SignalScout local-dev your-email@example.com
INGESTION_SEC_LIMIT_PER_COMPANY=1
INGESTION_SEC_INITIAL_DELAY_MS=60000
INGESTION_SEC_FIXED_DELAY_MS=3600000
INGESTION_RSS_FEEDS=https://www.sec.gov/news/pressreleases.rss
INGESTION_RSS_LIMIT_PER_FEED=1
INGESTION_RSS_INITIAL_DELAY_MS=90000
INGESTION_RSS_FIXED_DELAY_MS=3600000
